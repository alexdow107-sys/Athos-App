# Copy this file to .env and fill in real values.
# The real .env is gitignored and must NEVER be committed.

# MongoDB connection string (use a production cluster + a strong DB password)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=YourApp
DB_NAME=athos

# Auth — generate a long random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30
